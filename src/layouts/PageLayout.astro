---
import BaseLayout from './BaseLayout.astro';
interface Props { frontmatter: { title: string; description: string; }; }
const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}><section class="page-intro container"><span class="eyebrow">A LITTLE ABOUT THIS SPACE</span><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p></section><article class="prose about-prose container"><slot /></article></BaseLayout>
