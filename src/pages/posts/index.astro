---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, postUrl, url, dateLabel, readingMinutes } from '../../lib/posts';
import Icon from '../../components/Icon.astro';
const posts = await getPosts();
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))];
---
<BaseLayout title="所有文章"><section class="page-intro container"><span class="eyebrow">THE ARCHIVE</span><h1>每一篇，都是一个脚印。</h1><p>把零散的思考，整理成可以回望的记录。共 {posts.length} 篇文章。</p></section><section class="archive container">{years.map(year => <div class="archive-year"><h2>{year}<span> / NOTES</span></h2><div>{posts.filter(post => post.data.date.getUTCFullYear() === year).map(post => <article class="archive-row"><a class="archive-main" href={postUrl(post)}><div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>· {readingMinutes(post.body)} 分钟</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p></a><div class="archive-tags">{post.data.tags.map(tag => <a href={url(`tags/${encodeURIComponent(tag)}/`)}># {tag}</a>)}</div><a class="row-arrow" href={postUrl(post)} aria-label={`阅读 ${post.data.title}`}><Icon name="arrow" /></a></article>)}</div></div>)}</section></BaseLayout>
