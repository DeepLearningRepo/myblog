---
import ArticlePage from '../../components/ArticlePage.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, next: posts[i + 1] } }));
}
---
<ArticlePage {...Astro.props} />
