---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, url } from '../../lib/posts';
import Icon from '../../components/Icon.astro';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title="标签"><section class="page-intro container"><span class="eyebrow">EXPLORE BY TOPIC</span><h1>沿着好奇，继续探索。</h1><p>一个关键词，也许会带你走到意料之外的地方。</p></section><section class="topic-grid container">{tags.map((tag, i) => <a href={url(`tags/${encodeURIComponent(tag)}/`)} class="topic-card"><span class="topic-number">{String(i + 1).padStart(2, '0')} / TOPIC</span><h2>{tag}</h2><div><span>{posts.filter(post => post.data.tags.includes(tag)).length} 篇文章</span><Icon name="arrow" /></div></a>)}</section></BaseLayout>
