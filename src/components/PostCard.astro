---
import type { Post } from '../lib/posts';
import { dateLabel, postUrl, readingMinutes } from '../lib/posts';
import Artwork from './Artwork.astro';
import Icon from './Icon.astro';
interface Props { post: Post; }
const { post } = Astro.props;
---
<a class="post-card" href={postUrl(post)}>
  <Artwork kind={post.data.cover} />
  <div class="card-content">
    <div class="eyebrow">{post.data.tags[0] || '随笔'} <span class="tiny-dot"></span> {readingMinutes(post.body)} 分钟阅读</div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="card-bottom"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><Icon name="arrow" /></div>
  </div>
</a>
